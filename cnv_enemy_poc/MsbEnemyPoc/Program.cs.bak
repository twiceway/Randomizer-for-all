        }



        var outDir = OverlayMapStudioDir(gameDir);
        Directory.CreateDirectory(outDir);

        var outMsb = Path.Combine(outDir, $"{MapId}.msb.dcx");
        var outMsbe = Path.Combine(outDir, $"{MapId}.msbe.dcx");
        var existingOverlay = File.Exists(outMsb);



