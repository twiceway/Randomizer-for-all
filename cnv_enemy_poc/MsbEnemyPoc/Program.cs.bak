        Console.WriteLine($"Detail log {ResolveToolRoot()}\\enemy_poc_detail.txt");

        Console.WriteLine($"Detail log (game) {gameLog}");



        return verifySentinels.Count == patchTargets.Count && verifySoldiers.Count == 0 ? 0 : 3;

