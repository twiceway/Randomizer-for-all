            var areaId = args.FirstOrDefault(a => uint.TryParse(a, out _)) is { } s && uint.TryParse(s, out var id) ? id : 1042372808u;
            DumpArea(msb, areaId);
            return 0;
        }

        if (mode == "boss-batch1")
        {
            return RunBossBatch(
                gameDir, msb, enemies, detailLog, args,
                Batch1Plan, 42001, "boss_batch1", "boss_batch1_spoiler.txt",
